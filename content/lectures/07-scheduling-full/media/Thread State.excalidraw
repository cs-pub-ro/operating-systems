      "type": "text",
      "x": 877.1666666666669,
      "y": 809.5000000000001,
      "width": 558.8394775390625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
