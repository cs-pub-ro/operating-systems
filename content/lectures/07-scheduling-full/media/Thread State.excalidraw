      "isDeleted": false,
      "boundElements": [],
      "updated": 1763304660267,
      "link": null,
      "locked": false,
      "text": "when does a thread sleep:\n- wait for user to provide input\n- wait for disk to provide data\n- wait for network to provide data\n- wait() -> wait for child process to end execution\n- pthread_join() -> wait for new thread to end execution\n- sleep(100) -> wait for 100 seconds to expire",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "when does a thread sleep:\n- wait for user to provide input\n- wait for disk to provide data\n- wait for network to provide data\n- wait() -> wait for child process to end execution\n- pthread_join() -> wait for new thread to end execution\n- sleep(100) -> wait for 100 seconds to expire",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
