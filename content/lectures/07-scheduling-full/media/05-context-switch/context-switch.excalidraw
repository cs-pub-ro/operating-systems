   "index": null,
   "roundness": null,
   "seed": 341353512,
   "version": 1,
   "versionNonce": 313050504,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 and 2 are voluntary: the thread asked for it.   3 and 4 are involuntary: the kernel took the CPU away.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1 and 2 are voluntary: the thread asked for it.   3 and 4 are involuntary: the kernel took the CPU away.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "X6TnHgDgmYf8dAoQ1qT5",
   "type": "text",
   "x": 40,
   "y": 530,
   "width": 966.0,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 950060549,
   "version": 1,
   "versionNonce": 1472986487,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Not a domain switch: a system call takes the same thread from user mode into the kernel and back; nobody else runs.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not a domain switch: a system call takes the same thread from user mode into the kernel and back; nobody else runs.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "Bj3d7Sick1CsWo3LZuTJ",
   "type": "text",
   "x": 40,
   "y": 554,
   "width": 840.0,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1544808778,
   "version": 1,
   "versionNonce": 330688403,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A context switch swaps the thread on the CPU; the kernel does it, so it starts with a domain switch.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A context switch swaps the thread on the CPU; the kernel does it, so it starts with a domain switch.",
   "autoResize": true,
   "lineHeight": 1.25
  }
 ],
