   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "save TCB1's IP, SP and registers\nload TCB2's IP, SP and registers\nswitch page tables if needed",
   "fontSize": 11,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "save TCB1's IP, SP and registers\nload TCB2's IP, SP and registers\nswitch page tables if needed",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "v3efWCyzHAF75PWYbgLK",
   "type": "text",
   "x": 60,
   "y": 340,
   "width": 310.8,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 993299850,
   "version": 1,
   "versionNonce": 2008023422,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "why the running thread leaves the CPU",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "why the running thread leaves the CPU",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "DS1BAEl4eCzFiGW0aQoV",
   "type": "text",
   "x": 60,
   "y": 368,
   "width": 604.8,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 430022449,
   "version": 1,
   "versionNonce": 862596037,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1.  it calls something that blocks: read(), write(), sleep(), wait(), pthread_join()",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1.  it calls something that blocks: read(), write(), sleep(), wait(), pthread_join()",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "Ic7RsJvXyXDhfo2eK0ag",
   "type": "text",
   "x": 60,
   "y": 390,
   "width": 273.59999999999997,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1067177178,
   "version": 1,
   "versionNonce": 189515954,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2.  it gives the CPU up: sched_yield()",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2.  it gives the CPU up: sched_yield()",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "2WnKDd0RmTvE3dJSVA1L",
   "type": "text",
   "x": 60,
   "y": 412,
   "width": 345.59999999999997,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 301119807,
   "version": 1,
   "versionNonce": 2143391812,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3.  a thread with a higher priority became ready",
   "fontSize": 12,
