    {
      "id": "RgBWTUuWd95OToITo5X_z",
      "type": "text",
      "x": 192.8804321289058,
      "y": 1426.1666666666674,
      "width": 985.2391357421875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1869244930,
      "version": 502,
      "versionNonce": 1000380290,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763307859247,
      "link": null,
      "locked": false,
      "text": "RUN -> SLEEPING: 1. thread calls a blocking function (read(), write(), sleep(), wait(), pthread_join())\nRUN -> READY:\n    2. yields: voluntarily frees the CPU\n    3. priority is too low: higher priority thread is scheduled\n    4. thread time slice expired",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RUN -> SLEEPING: 1. thread calls a blocking function (read(), write(), sleep(), wait(), pthread_join())\nRUN -> READY:\n    2. yields: voluntarily frees the CPU\n    3. priority is too low: higher priority thread is scheduled\n    4. thread time slice expired",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
