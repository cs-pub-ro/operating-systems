    {
      "id": "WouPQ_PUakq1eAgaraj3Z",
      "type": "text",
      "x": -692.1195678710938,
      "y": 360.33333333333337,
      "width": 985.2391357421875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1743576862,
      "version": 395,
      "versionNonce": 1121021982,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763307499999,
      "link": null,
      "locked": false,
      "text": "RUN -> SLEEPING: 1. thread calls a blocking function (read(), write(), sleep(), wait(), pthread_join())\nRUN -> READY:\n    2. yields: voluntarily frees the CPU\n    3. priority is too low: higher priority thread is scheduled\n    4. thread time slice expired",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RUN -> SLEEPING: 1. thread calls a blocking function (read(), write(), sleep(), wait(), pthread_join())\nRUN -> READY:\n    2. yields: voluntarily frees the CPU\n    3. priority is too low: higher priority thread is scheduled\n    4. thread time slice expired",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "kDr_fY4-rRYTPqe1tHQMu",
      "type": "text",
      "x": 503.8333333333334,
      "y": 778.6666666666667,
      "width": 623.139404296875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1049368386,
      "version": 177,
      "versionNonce": 1600039746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763307555546,
      "link": null,
      "locked": false,
      "text": "Scheduler question:\n    - What to prioritize?\n        A. interactivity / fairness: get each thread its fair share\n        B. throughput: get as much work done as possible",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scheduler question:\n    - What to prioritize?\n        A. interactivity / fairness: get each thread its fair share\n        B. throughput: get as much work done as possible",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "679FYdiJXjO6HynaBDfSh",
      "type": "text",
      "x": 268.0000000000001,
      "y": 903.6666666666667,
      "width": 829.0391845703125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 611992258,
      "version": 225,
      "versionNonce": 1416159874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763307604123,
      "link": null,
      "locked": false,
      "text": "A. small time slice: frequent context switches, each thread gets its share\nB. large time slide: less frequent context switches, reduced context switch overhead",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. small time slice: frequent context switches, each thread gets its share\nB. large time slide: less frequent context switches, reduced context switch overhead",
      "autoResize": true,
      "lineHeight": 1.25,
