   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A thread is always in exactly one of the three. Most threads, most of the time, are blocked: that is why 4,614 threads fit on 24 CPUs.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A thread is always in exactly one of the three. Most threads, most of the time, are blocked: that is why 4,614 threads fit on 24 CPUs.",
