   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "elapsed = user + system + time spent waiting.  For almost every process, the last term is nearly all of it.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "elapsed = user + system + time spent waiting.  For almost every process, the last term is nearly all of it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
