  },
  {
   "id": "c76RpqwmSCb1LChYbFhe",
   "type": "text",
   "x": 40,
   "y": 560,
   "width": 957.5999999999999,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 1719474613,
   "version": 1,
   "versionNonce": 554956722,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The scheduler is a function the kernel calls: given every thread and what it has been doing, it picks one per CPU.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The scheduler is a function the kernel calls: given every thread and what it has been doing, it picks one per CPU.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ljJ7s3RQy1jL4qISWZr8",
   "type": "text",
   "x": 40,
   "y": 584,
   "width": 991.1999999999999,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": null,
   "roundness": null,
   "seed": 953673965,
   "version": 1,
   "versionNonce": 29636779,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It is called thousands of times a second, each time something changes: a thread blocks, wakes up, or runs out of time.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It is called thousands of times a second, each time something changes: a thread blocks, wakes up, or runs out of time.",
   "autoResize": true,
   "lineHeight": 1.25
  }
 ],
