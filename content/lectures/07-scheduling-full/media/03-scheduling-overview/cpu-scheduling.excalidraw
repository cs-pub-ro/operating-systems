   "text": "#threads >> #CPUs",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "#threads >> #CPUs",
   "autoResize": true,
