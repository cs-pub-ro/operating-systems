   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A channel has two ends, and the second end has to find the first: by a name in the file system,",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A channel has two ends, and the second end has to find the first: by a name in the file system,",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
