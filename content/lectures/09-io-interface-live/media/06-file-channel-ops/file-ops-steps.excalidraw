   "version": 1,
   "versionNonce": 1677898848,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "After the truncation the pointer is past the end: reading there gives nothing, and writing there leaves a hole behind.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "After the truncation the pointer is past the end: reading there gives nothing, and writing there leaves a hole behind.",
