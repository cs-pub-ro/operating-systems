   "updated": 1,
   "link": null,
   "locked": false,
   "text": "read() and write() move the pointer; lseek() sets it; ftruncate() changes the size and leaves the pointer alone.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "read() and write() move the pointer; lseek() sets it; ftruncate() changes the size and leaves the pointer alone.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
