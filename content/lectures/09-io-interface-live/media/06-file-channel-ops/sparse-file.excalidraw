   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Blocks are given to the file when something is written to them. A part that was never written is a hole:",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Blocks are given to the file when something is written to them. A part that was never written is a hole:",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
