      "roundness": null,
      "seed": 602172146,
      "version": 1,
      "versionNonce": 308624087,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Most programs hit almost always, because they use the same pages again and again;",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Most programs hit almost always, because they use the same pages again and again;",
      "autoResize": true,
      "lineHeight": 1.25
    },
