      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Walking 512 MB one byte per 4 KB page: 92% of the accesses miss the TLB.  The same walk with 2 MB pages: almost none.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Walking 512 MB one byte per 4 KB page: 92% of the accesses miss the TLB.  The same walk with 2 MB pages: almost none.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f2",
      "type": "text",
      "x": 40,
      "y": 422,
      "width": 1000,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
