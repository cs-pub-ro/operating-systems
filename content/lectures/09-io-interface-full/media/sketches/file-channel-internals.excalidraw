      "boundElements": [],
      "updated": 1765714002290,
      "link": null,
      "locked": false,
      "text": "fd1 = open(\"a.txt\",...); /* create channel structure */\nfd2= dup(fd1); /* have a new fd refere the same channel structure */\n/* two fds references same channel structure */\n/* both fds \"share\" the same file pointer */",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fd1 = open(\"a.txt\",...); /* create channel structure */\nfd2= dup(fd1); /* have a new fd refere the same channel structure */\n/* two fds references same channel structure */\n/* both fds \"share\" the same file pointer */",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
