      "updated": 1765713934529,
      "link": null,
      "locked": false,
      "text": "fd1 = open(\"a.txt\",...); /* create channel structure */\nfd2= open(\"a.txt\", ...); /* create another channel structure */\n/* each channel structure has its own file pointer */\n/* both channel structures refer the same file */",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fd1 = open(\"a.txt\",...); /* create channel structure */\nfd2= open(\"a.txt\", ...); /* create another channel structure */\n/* each channel structure has its own file pointer */\n/* both channel structures refer the same file */",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "NhwPwlfIhLWbR962ucwnR",
      "type": "text",
