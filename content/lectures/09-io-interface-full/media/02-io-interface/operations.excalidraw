   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Creating and deleting concern the thing at the other end; opening and closing concern the channel, and only the process that has it.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Creating and deleting concern the thing at the other end; opening and closing concern the channel, and only the process that has it.",
