    {
      "id": "RQjymh7dzV0SfUnEzMBIP",
      "type": "text",
      "x": 1267,
      "y": 140,
      "width": 590.9984130859375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1391874186,
      "version": 181,
      "versionNonce": 927843158,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765226721964,
      "link": null,
      "locked": false,
      "text": "spinlock: lock, busy waiting; unlock: open = 1\nmutex: lock -> sleep / blocked\n         unlock -> wakeup",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "spinlock: lock, busy waiting; unlock: open = 1\nmutex: lock -> sleep / blocked\n         unlock -> wakeup",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "s4b6Nb35ceJOa-xGeNnT-",
      "type": "text",
      "x": 1363,
      "y": 287,
      "width": 443.43780517578125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 2047480778,
      "version": 84,
      "versionNonce": 334084810,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765226780994,
      "link": null,
      "locked": false,
      "text": "small critical sections -> spinlock\nlarge critical sections -> mutex",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "small critical sections -> spinlock\nlarge critical sections -> mutex",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ctu4URG0eUTqtGN7Ec7sg",
      "type": "text",
      "x": 625,
      "y": 672,
      "width": 1497.7540283203125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1051881814,
      "version": 388,
      "versionNonce": 463599190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765227572626,
      "link": null,
      "locked": false,
      "text": "1. data partitioning (per-thread data -> TLS, stack, reentrant)\n    minimize synchronization points (critical sections)\n2. atomic operations (__sync_fetch_and_add())\n3. spinlock - small critical sections - beware of multiple threads on many cores (cache misses, cache thrashing)\n4. mutex - large critical sections",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. data partitioning (per-thread data -> TLS, stack, reentrant)\n    minimize synchronization points (critical sections)\n2. atomic operations (__sync_fetch_and_add())\n3. spinlock - small critical sections - beware of multiple threads on many cores (cache misses, cache thrashing)\n4. mutex - large critical sections",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    }
