      "seed": 1592276438,
      "version": 212,
      "versionNonce": 271333142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765194014266,
      "link": null,
      "locked": false,
      "text": "running->ready\n    voluntary: yield()\n    non-vol:\n        a) time slice expires\n        b) another thread is prioritary",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "running->ready\n    voluntary: yield()\n    non-vol:\n        a) time slice expires\n        b) another thread is prioritary",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ojI2_uidmH7TKIaxdUVq-",
      "type": "text",
      "x": 528,
      "y": 888.6666666666667,
      "width": 719.2108764648438,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 2077442326,
      "version": 261,
      "versionNonce": 1437978506,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765194191929,
      "link": null,
      "locked": false,
      "text": "non-voluntary context switch\n- triggered by timer interrupt\n    a) interrupt is triggered\n    b) scheduler is invoked\n    c) scheduler updates priorities, timeslices\n    d) scheduler can decide to replace current thread",
