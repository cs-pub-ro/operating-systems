    },
    {
      "id": "eZS_mm5VAkHSQeR3lSc8Y",
      "type": "text",
      "x": 340.5,
      "y": 157,
      "width": 506.9420166015625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
