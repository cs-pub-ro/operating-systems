   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sharing made it wrong. Locking made it right, and slow. Not sharing made it right, and fast.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sharing made it wrong. Locking made it right, and slow. Not sharing made it right, and fast.",
   "autoResize": true,
   "lineHeight": 1.25
  },
