   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Concurrent: the two threads are alive over the same period, and may touch the same things.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Concurrent: the two threads are alive over the same period, and may touch the same things.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "Z7LtOWNTNED5PJ18GpO3",
   "type": "text",
