    },
    {
      "id": "6puNXGkSqAiHbmYMglbME",
      "type": "text",
      "x": 735.7000122070312,
      "y": 466,
      "width": 397.1996765136719,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1608564639,
      "version": 113,
      "versionNonce": 301556159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762088744092,
      "link": null,
      "locked": false,
      "text": "1. reserve virtual memory\n2. allocate physical memory\n3. map physical memory to virtual memory",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. reserve virtual memory\n2. allocate physical memory\n3. map physical memory to virtual memory",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "avmVvxacp1TieKjxhVFwm",
      "type": "text",
      "x": 525,
      "y": 575,
      "width": 493.4395751953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1366113791,
      "version": 151,
      "versionNonce": 1954970719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762088874525,
      "link": null,
      "locked": false,
      "text": "mmap, malloc -> 1. reserve virtual memory\nat access -> 2 + 3: allocate + map physical memory",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "mmap, malloc -> 1. reserve virtual memory\nat access -> 2 + 3: allocate + map physical memory",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "2zTJJJz7cWUKHr0BFV75J",
      "type": "text",
      "x": 670,
      "y": 671,
      "width": 700.4593505859375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1414503153,
      "version": 244,
      "versionNonce": 1327223857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762088849644,
      "link": null,
      "locked": false,
      "text": "1. you can reserve virtual memory without backing of physical memory\n2. you can't allocate physical memory without mapping to virtual memory\n\nall addresses are virtual memory addresses",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. you can reserve virtual memory without backing of physical memory\n2. you can't allocate physical memory without mapping to virtual memory\n\nall addresses are virtual memory addresses",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
