    {
      "id": "foot1",
      "type": "text",
      "x": 40,
      "y": 250,
      "width": 900,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 877025526,
      "version": 1,
      "versionNonce": 1599086657,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Only the first segment costs RAM.  The other three are promises the kernel keeps on demand, page by page.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only the first segment costs RAM.  The other three are promises the kernel keeps on demand, page by page.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "foot2",
      "type": "text",
      "x": 40,
      "y": 274,
      "width": 900,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 573513463,
      "version": 1,
      "versionNonce": 1194474011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Add up the RSS of every process and the shared pages are counted several times,",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Add up the RSS of every process and the shared pages are counted several times,",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "foot3",
      "type": "text",
      "x": 40,
      "y": 296,
      "width": 900,
      "height": 17.5,
