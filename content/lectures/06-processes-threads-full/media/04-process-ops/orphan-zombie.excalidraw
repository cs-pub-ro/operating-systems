3374, "width": 0, "height": 0.8333333333332575, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "b02", "roundness": null, "seed": 1389787394, "version": 5, "versionNonce": 1340489794, "isDeleted": false, "boundElements": [], "updated": 1763301160248, "link": null, "locked": false, "points": [[0, 0], [0, 0.8333333333332575], [0, 0]], "pressures": [], "simulatePressure": true, "lastCommittedPoint": null, "created": null, "strokeOptions": {"variability": "variable", "streamline": 0.5}}, {"id": "wBLGguWN0KSabVFNnBUg4", "type": "text", "x": 1374.6666666666665, "y": 1851.1666666666706, "width": 403.1995849609375, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "b03", "roundness": null, "seed": 1306564546, "version": 177, "versionNonce": 1515037506, "isDeleted": false, "boundElements": [], "updated": 1763301206971, "link": null, "locked": false, "text": "a) parent process ended execution\nb) child process continues execution\n\n- child process is adopted by init process", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "a) parent process ended execution\nb) child process continues execution\n\n- child process is adopted by init process", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "qAMkknCFE4EhcYsHqPNSE", "type": "text", "x": 2030.566874186198, "y": 1852.8333333333374, "width": 529.87939453125, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "b04", "roundness": null, "seed": 1802259038, "version": 413, "versionNonce": 1567066782, "isDeleted": false, "boundElements": [], "updated": 1763301251958, "link": null, "locked": false, "text": "a) child process ended execution\nb) parent process continues execution without waiting\n\n- zombie process disappears once it's been waited", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "a) child process ended execution\nb) parent process continues execution without waiting\n\n- zombie process disappears once it's been waited", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "q80NOhT9xvP1w0Iiq7dYN", "type": "text", "x": 1560.4999999999998, "y": 2012.8333333333374, "width": 641.659423828125, "height": 25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "b05", "roundness": null, "seed": 182450974, "version": 117, "versionNonce": 250668126, "isDeleted": false, "boundElements": [], "updated": 1763301305035, "link": null, "locked": false, "text": "if a zombie becomes orphan, it is adopted by init, and it is reaped", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "if a zombie becomes orphan, it is adopted by init, and it is reaped", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}, {"id": "VPgfC5TCflliIwb6FzOK5", "type": "text", "x": 1566.333333333333, "y": 2068.6666666666706, "width": 659.3193359375, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "b06", "roundness": null, "seed": 935304898, "version": 248, "versionNonce": 2019427294, "isDeleted": false, "boundElements": [], "updated": 1763301364771, "link": null, "locked": false, "text": "an orphan cannot be a zombie\nif a process become an orphan, it was adopted by init\nthe moment an (orphan) process ends execution, it is reaped by init", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "an orphan cannot be a zombie\nif a process become an orphan, it was adopted by init\nthe moment an (orphan) process ends execution, it is reaped by init", "autoResize": true, "lineHeight": 1.25, "created": null, "labelPosition": null, "baseFontSize": null}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#ffffff", "lockedMultiSelections": {}}, "files": {}}