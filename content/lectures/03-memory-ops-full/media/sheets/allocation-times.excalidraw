      "updated": 1762012841949,
      "link": null,
      "locked": false,
      "text": "static vs dynamic memory area / zone\n\nstatic is fixed sized, dynamic is variable size\nstatic is initialized from binary exec; dynamic is initialized with 0",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "static vs dynamic memory area / zone\n\nstatic is fixed sized, dynamic is variable size\nstatic is initialized from binary exec; dynamic is initialized with 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
