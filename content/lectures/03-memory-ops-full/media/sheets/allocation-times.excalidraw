    {
      "id": "_TXL3TzBY2eKwSorRv069",
      "type": "text",
      "x": 426,
      "y": 1667,
      "width": 957.379150390625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 501329567,
      "version": 479,
      "versionNonce": 371756977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762013789983,
      "link": null,
      "locked": false,
      "text": "static vs dynamic executable\n\nstatic includes all library code; executable has reference to library code\nprocess from static only has static executable memory areas\nprocess from dynamic has static executable memory areas + shared / dynamic library memory areas\n\nallocation & management of dynamic memory areas / zones is identical",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "static vs dynamic executable\n\nstatic includes all library code; executable has reference to library code\nprocess from static only has static executable memory areas\nprocess from dynamic has static executable memory areas + shared / dynamic library memory areas\n\nallocation & management of dynamic memory areas / zones is identical",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "YHzSidp19Uez7kQIOd5tQ",
      "type": "text",
      "x": 489,
      "y": 1965,
      "width": 551.37939453125,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 771474719,
      "version": 387,
      "versionNonce": 2108628639,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762033519793,
      "link": null,
      "locked": false,
      "text": "text: static, perm: r-x\nrodata: static, perm: r--\ndata: static, perm: rw-\nuninit data / bss: static, perm: rw-\nstack: dynamic, grows down, rw-\nheap: dynamic, grows up, rw-\nmemory mappings: dynamic, ... (any permissions)\n\ndynamic libraries (just for processes from dynamic exec):\n    text: static, perm: r-x\n    rodata: static, perm: r--\n    data: static, perm: rw-\n    uninit data / bss: static, perm: rw-",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "text: static, perm: r-x\nrodata: static, perm: r--\ndata: static, perm: rw-\nuninit data / bss: static, perm: rw-\nstack: dynamic, grows down, rw-\nheap: dynamic, grows up, rw-\nmemory mappings: dynamic, ... (any permissions)\n\ndynamic libraries (just for processes from dynamic exec):\n    text: static, perm: r-x\n    rodata: static, perm: r--\n    data: static, perm: rw-\n    uninit data / bss: static, perm: rw-",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
