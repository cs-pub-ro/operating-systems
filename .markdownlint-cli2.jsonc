// Markdown style for this repository, as written down in dev/content-rules.md.
// Run it as `markdownlint-cli2 "**/*.md"`, and add `--fix` to repair what can
// be repaired automatically.  Files to check are named on the command line, on
// purpose: a `globs` key here would be added to whatever is named, so `--fix`
// on one file would rewrite the whole repository.
{
  "ignores": [
    // Third-party README, imported as it is.
    "content/labs/02-os-interface-live/bonus-printf/utils/printf/README.md",
    "_site/**",
    "node_modules/**",
    ".venv/**",
    ".claude/**"
  ],
  "config": {
    "default": true,

    // dev/content-rules.md: `*` for unordered lists, `1.` for every ordered item,
    // one space after the marker.
    "MD004": { "style": "asterisk" },
    "MD029": { "style": "one" },
    "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 },
    "MD007": { "indent": 2 },

    // dev/content-rules.md: one sentence per line, however long the sentence is,
    // so the limit is not a wrapping width -- it is a guard against a runaway
    // line, such as a whole paragraph written as one line.  Code blocks and
    // tables are as wide as the output they quote.
    "MD013": {
      "line_length": 400,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },

    // C sources are indented with tabs, and are quoted as they are.
    "MD010": { "code_blocks": false },

    // Session READMEs use bold lead-ins ("**The lesson.**"), bare links to
    // challenge pages, and the odd HTML tag.
    "MD033": false,
    "MD034": false,
    "MD036": false,

    // Long walkthroughs, such as the in-memory database demo, are written as
    // several level-one chapters, and repeat headings such as "Build" under
    // different sections.
    "MD024": { "siblings_only": true },
    "MD025": false,

    // A README that opens with a question instead of a heading is fine; the
    // site adds a heading from the directory name.
    "MD041": false,

    // Two quotes separated by a blank line are two quote blocks on purpose,
    // such as the two lessons of the printf vs write demo.
    "MD028": false,

    // Table cells are not padded to a common width.
    "MD060": false
  }
}
